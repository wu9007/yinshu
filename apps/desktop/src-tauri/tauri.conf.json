{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "印枢",
  "mainBinaryName": "yinshu",
  "version": "1.0.0",
  "identifier": "cn.yinshu.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 480,
        "height": 720,
        "minWidth": 440,
        "minHeight": 560,
        "maximizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "linux": {
      "rpm": {
        "provides": ["yinshu"],
        "conflicts": ["yinshu-server"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
